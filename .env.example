# Existing payment variables below are legacy documentation only.
# Checkout is deferred; do not configure or activate a payment provider for this assignment.
# Customer development needs no SMTP credentials: it uses a local outbox.

VITE_GA_MEASUREMENT_ID=

# Square production checkout. Keep the access token server-side only.
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_VERSION=2026-07-15
SQUARE_REDIRECT_URL=

# Optional legacy fallback if you want to redirect to a fixed Square link.
VITE_SQUARE_CHECKOUT_URL=

# Future reviewed customer-service deployment only; never put secrets in VITE_ variables.
# CUSTOMER_ENV=production
# CUSTOMER_SECRET_KEY=<set securely outside source control>
# CUSTOMER_ALLOWED_HOSTS=<approved website hostname>
# CUSTOMER_FRONTEND_URL=https://<approved website hostname>
# CUSTOMER_DATABASE=<private persistent SQLite path>
# CUSTOMER_EMAIL_HOST=<approved SMTP host>
# CUSTOMER_EMAIL_PORT=587
# CUSTOMER_EMAIL_USER=<SMTP username>
# CUSTOMER_EMAIL_PASSWORD=<set securely outside source control>
# CUSTOMER_FROM_EMAIL=<verified sender>
