VITE_GA_MEASUREMENT_ID=

# Square production checkout. Keep the access token server-side only.
# Application ID and Location ID are used to load Square's embedded payment form.
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_VERSION=2026-07-15
SQUARE_REDIRECT_URL=

# PayPal sandbox checkout. Keep the client secret server-side only.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
