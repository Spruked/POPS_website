[Unit]
Description=POPS Website API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bryan
WorkingDirectory=/home/bryan/projects/POPS_website
ExecStart=/home/bryan/.venvs/pops-website/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
