{
  "name": "pops-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "uvicorn backend.main:app --host 0.0.0.0 --port 8787",
    "build": "node scripts/generate-sitemap.mjs && tsc && vite build",
    "preview": "vite preview",
    "dev:customers": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-customer-dev.ps1",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build:crawl": "npm run build && node scripts/prerender.mjs",
    "test:browser": "node scripts/verify-launch.cjs",
    "test:customers": "node scripts/test-python.mjs customer",
    "report:launch": "node scripts/report-launch.mjs",
    "test:navigation": "node scripts/verify-navigation.cjs",
    "test:demo": "node src/pops-demo-app/scripts/test-demo.cjs",
    "test:demo:production": "node src/pops-demo-app/scripts/test-production.cjs",
    "test:protected": "node scripts/verify-protected.cjs",
    "dev:orb": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-orb-dev.ps1",
    "test:customer-browser": "node scripts/verify-customers.cjs",
    "test:orb": "node scripts/test-python.mjs orb",
    "context:orb": "node scripts/generate-orb-context.mjs",
    "test:imports": "node scripts/verify-imports.cjs --tracked",
    "test:orb-speech": "node scripts/verify-orb-speech.cjs",
    "test:orb-recovery": "node scripts/verify-orb-recovery.cjs"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "playwright": "^1.64.1",
    "typescript": "^5.0.0",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  }
}
